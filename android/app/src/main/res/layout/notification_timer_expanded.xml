<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Top Row: Task Title + Status Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <!-- Task Title -->
        <TextView
            android:id="@+id/notification_task_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Task Name"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Status Badge -->
        <TextView
            android:id="@+id/notification_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FOCUSING"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#CCFFFFFF"
            android:background="@drawable/notification_badge_glass"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp" />

    </LinearLayout>

    <!-- Timer Display Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <!-- Productive Time (large) -->
        <TextView
            android:id="@+id/notification_productive_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"
            android:fontFamily="monospace" />

        <!-- Separator + Target (subscript) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" / "
            android:textSize="13sp"
            android:textColor="#AAFFFFFF"
            android:layout_marginBottom="4dp"
            android:layout_gravity="bottom" />

        <TextView
            android:id="@+id/notification_target_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="25:00"
            android:textSize="13sp"
            android:textColor="#AAFFFFFF"
            android:fontFamily="monospace"
            android:layout_marginBottom="4dp"
            android:layout_gravity="bottom" />

        <!-- Spacer -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Pause/Resume button -->
        <ImageView
            android:id="@+id/notification_pause_btn"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_notification_pause"
            android:scaleType="centerInside"
            android:padding="7dp"
            android:background="@drawable/notification_badge_glass"
            android:contentDescription="Pause" />

    </LinearLayout>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/notification_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/notification_progress_glass"
        android:layout_marginBottom="8dp" />

    <!-- Bottom Row: Progress % + Wasted -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Progress % -->
        <TextView
            android:id="@+id/notification_progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0% complete"
            android:textSize="11sp"
            android:textColor="#BBFFFFFF" />

        <!-- Spacer -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Wasted time -->
        <LinearLayout
            android:id="@+id/notification_wasted_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Idle: "
                android:textSize="11sp"
                android:textColor="#80FFB74D" />

            <TextView
                android:id="@+id/notification_wasted_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#AAFFB74D"
                android:fontFamily="monospace" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
